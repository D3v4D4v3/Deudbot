# ===== DeudBot - Configuración de Entorno =====
# Copia este archivo como .env y modifica los valores

# Puerto del servidor
PORT=3000

# Credenciales del panel de administración
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_contraseña

# Entorno: development | production
NODE_ENV=production

# Orígenes permitidos para CORS (separar con coma si hay varios)
ALLOWED_ORIGINS=*

# Secreto para las sesiones (generar uno aleatorio)
SESSION_SECRET=generar-un-secreto-aleatorio-aqui
